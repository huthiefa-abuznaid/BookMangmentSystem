# Connect to Postgres via the shared transaction-mode pooler (IPv4-only).
# Paste the exact Transaction pooler URI from Supabase > Connect.
DATABASE_URL=""
# Connect to Postgres via the shared session-mode pooler (used for migrations).
# Paste the exact Session pooler URI from Supabase > Connect.
DIRECT_URL=""
# These are database connection strings, not the Supabase API URL or publishable key.
# Replace both empty values before running Prisma commands. Keep this file private.
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Required to create the first Manager account when running npm run db:seed.
BOOTSTRAP_MANAGER_EMAIL="manager@example.com"
BOOTSTRAP_MANAGER_PASSWORD="replace-with-a-unique-password-12-chars-minimum"

# Optional: seed Receptionist, Warehouseman, and sample Customer demo accounts.
# All optional demo accounts use this password. Keep this disabled in production.
DEMO_ACCOUNT_PASSWORD=""

# Password reset email API. Configure a provider-compatible JSON email endpoint.
# The endpoint must accept { from, to, subject, text, html } with Bearer auth.
EMAIL_API_URL=""
EMAIL_API_KEY=""
EMAIL_FROM=""
APP_BASE_URL=""

# Encrypted scheduled database backups. Generate a random 32-byte key and base64 encode it.
BACKUP_DIR=""
BACKUP_ENCRYPTION_KEY=""
BACKUP_RETENTION_DAYS="30"
